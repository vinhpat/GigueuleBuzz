# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# BASE_URL: The URL of your deployed Vercel backend
BASE_URL=https://gigueule-buzz.vercel.app/

# SUPABASE_URL: Your Supabase Project API URL (configured in Vercel settings for backend)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_KEY: Your Supabase Service Role Key or Anon Key (configured in Vercel settings for backend)
SUPABASE_KEY=your-supabase-anon-or-service-key
